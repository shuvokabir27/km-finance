# ==============================================================================
# KUAKATA MULTIMEDIA FINANCE - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your Supabase credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Required)
# Get these from your Supabase Project Settings -> API
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_URL="https://your-project-id.supabase.co"

# Your Supabase Public / Anon / Publishable Key
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key-here"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key-here"

# Your Supabase Service Role Key (Keep secret! Only used on the server)
# Found in Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ------------------------------------------------------------------------------
# DEPLOYMENT & HOSTING (Optional)
# ------------------------------------------------------------------------------
# Your deployed public URL (e.g. https://finance.yourdomain.com or https://your-app.vercel.app)
# If hosted on Vercel, VERCEL_URL is used automatically as fallback.
SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# SMS OTP & NOTIFICATIONS (Optional - BulkSMSBD)
# Used for member OTP login and dues SMS alerts
# ------------------------------------------------------------------------------
BULKSMSBD_API_KEY=""
BULKSMSBD_SENDER_ID=""

# ------------------------------------------------------------------------------
# AI GREETING GENERATION (Optional)
# If left blank, warm pre-set Bangla greeting templates are used automatically.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"
# AI_BASE_URL="https://api.openai.com/v1"
